# AI Certification Prep Assistant Environment Configuration
# Copy this file to .env and fill in your actual values

# ==================== Required ====================

# Google Gemini API Key (for AI agents and embeddings)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Format: mongodb+srv://username:password@cluster.mongodb.net/database-name
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/<database>?retryWrites=true&w=majority

# ==================== Google OAuth (Optional) ====================

# Google OAuth Client ID from Google Cloud Console
# Create OAuth 2.0 Client: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth Redirect URI (must match Google Cloud Console configuration)
# Local: http://localhost:8501
# Production: https://your-domain.azurewebsites.net
GOOGLE_REDIRECT_URI=http://localhost:8501

# ==================== FireCrawl API Key ====================
FIRECRAWL_API_KEY=your-firecrawl-api-key-here

# ==================== Application Settings ====================

# Environment (development/production)
APP_ENV=development

# Debug mode (true/false)
DEBUG=true